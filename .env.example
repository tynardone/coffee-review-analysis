# Copy to .env and fill in. Never commit .env.
# Real environment variables win over this file, and this file wins over
# config/settings.toml.

# Needed only by `fetch-exchange-rates`. Free tier: https://openexchangerates.org/signup/free
# (The older unprefixed name, OPENEXCHANGERATES_API_ID, is still accepted.)
COFFEE_OPENEXCHANGERATES_API_ID=

# Optional. Where pipeline data and hand-kept seed files live; empty means
# data/ and seeds/ at the project root.
COFFEE_DATA_DIR=
COFFEE_SEEDS_DIR=

# Optional. Any value in config/settings.toml can be overridden here, using a
# double underscore for a value inside a table, for example:
# COFFEE_LOG_LEVEL=DEBUG
# COFFEE_SCRAPE__CONCURRENCY=4
